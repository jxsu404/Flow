# Flow — gratis

Copia este archivo a `.env.local`. No hace falta tarjeta de crédito.

# Neon Free (cadena del pooler)
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google Cloud OAuth (consent screen en modo Testing)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google AI Studio — Gemini Flash (gratis)
GEMINI_API_KEY=
